<resources>
    <style name="NumberButton">
        <item name="android:background">@drawable/number_button_background</item>
        <item name="android:textColor">@color/number_button_text_color</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- Убираем стандартный ripple/тень Material-кнопки, если она мешает -->
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
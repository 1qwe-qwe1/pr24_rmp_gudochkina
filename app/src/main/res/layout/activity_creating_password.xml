<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreatingPasswordActivity">
    <!-- Цифровая клавиатура -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ряд 1: 1, 2, 3 -->
        <Button
            android:id="@+id/btn1"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="1"
            android:textSize="28sp"
            style="@style/NumberButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed" />

        <Button
            android:id="@+id/btn2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="2"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="@id/btn1"
            app:layout_constraintStart_toEndOf="@id/btn1"
            app:layout_constraintEnd_toStartOf="@id/btn3" />

        <Button
            android:id="@+id/btn3"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="3"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="@id/btn1"
            app:layout_constraintStart_toEndOf="@id/btn2"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ряд 2: 4, 5, 6 -->
        <Button
            android:id="@+id/btn4"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="4"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn1"
            app:layout_constraintStart_toStartOf="@id/btn1" />

        <Button
            android:id="@+id/btn5"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="5"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn2"
            app:layout_constraintStart_toStartOf="@id/btn2" />

        <Button
            android:id="@+id/btn6"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="6"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn3"
            app:layout_constraintStart_toStartOf="@id/btn3" />

        <!-- Ряд 3: 7, 8, 9 -->
        <Button
            android:id="@+id/btn7"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="7"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn4"
            app:layout_constraintStart_toStartOf="@id/btn4" />

        <Button
            android:id="@+id/btn8"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="8"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn5"
            app:layout_constraintStart_toStartOf="@id/btn5" />

        <Button
            android:id="@+id/btn9"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="9"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn6"
            app:layout_constraintStart_toStartOf="@id/btn6" />

        <!-- Ряд 4: пусто, 0, удалить -->
        <View
            android:id="@+id/emptySpace"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn7"
            app:layout_constraintStart_toStartOf="@id/btn7" />

        <Button
            android:id="@+id/btn0"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="0"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn8"
            app:layout_constraintStart_toStartOf="@id/btn8" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="⌫"
            android:textSize="28sp"
            style="@style/NumberButton"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn9"
            app:layout_constraintStart_toStartOf="@id/btn9" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>